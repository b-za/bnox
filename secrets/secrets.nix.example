# agenix rules — copy to secrets.nix and replace placeholders with real keys.
# Per D-008: every secret has TWO recipients — the host SSH key + a recovery age key.
let
  hostKey = "ssh-ed25519 AAAA...";  # host's /etc/ssh/ssh_host_ed25519_key.pub
  recoveryKey = "age1...";          # operator-held off-host recovery key (age format)
  all = [
    hostKey
    recoveryKey
  ];
in
{
  "caddy-tls.age".publicKeys = all;
  "nats-auth.age".publicKeys = all;
}
