#!/usr/bin/env python3
"""Session End - Sets session_ended timestamp and marks session as completed"""

import sys
import re
import argparse
from datetime import datetime
from pathlib import Path

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--session-id', required=True)
    parser.add_argument('--write', action="store_true")
    parser.add_argument('--output-path')
    args = parser.parse_args()

    session_file = Path("docs/graph") / f"{args.session_id}.md"
    if not session_file.exists():
        print(f"ERROR: Session file not found: {session_file}", file=sys.stderr)
        sys.exit(1)

    content = session_file.read_text()

    if 'type: "session"' not in content and 'type: session' not in content and 'type: "session-note"' not in content and 'type: session-note' not in content:
        print("ERROR: Not a session type", file=sys.stderr)
        sys.exit(1)

    match = re.search(r'^(---.*?---)', content, re.DOTALL)
    if not match:
        print("ERROR: Invalid frontmatter", file=sys.stderr)
        sys.exit(1)

    timestamp = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")

    if not re.search(r'^session_started:', match.group(1), re.MULTILINE):
        print("WARNING: session_started not set - session may not have been started properly", file=sys.stderr)

    if not re.search(r'^handover:', match.group(1), re.MULTILINE):
        print("WARNING: No handover field - close-out checklist may be incomplete", file=sys.stderr)

    if not re.search(r'^jobs:', match.group(1), re.MULTILINE):
        print("WARNING: No jobs field - session has no assigned jobs", file=sys.stderr)

    new_content = content

    # Update session_ended
    if re.search(r'^session_ended:', match.group(1), re.MULTILINE):
        new_content = re.sub(r'^session_ended:.*$', f'session_ended: "{timestamp}"', content, flags=re.MULTILINE)
    else:
        # Insert INSIDE the frontmatter, before the closing fence (inserting
        # at the first '---' would land the field above the block)
        fm = match.group(1)
        fm = fm[:-3].rstrip('\n') + f'\nsession_ended: "{timestamp}"\n---'
        new_content = content[:match.start()] + fm + content[match.end():]

    # Update tags: remove planned/active, add completed
    new_content = new_content.replace('  - "planned"', '')
    new_content = new_content.replace('  - "active"', '')
    if '  - "completed"' not in new_content:
        new_content = re.sub(r'(tags:)', r'\1\n  - "completed"', new_content, count=1)

    # Clean up empty lines in tags
    new_content = re.sub(r'  - \s*\n', '', new_content)

    with open(f"docs/graph/{args.session_id}.md", "w") as f:
        f.write(new_content)

    print(f"Updated session_ended to {timestamp}")

if __name__ == '__main__':
    main()